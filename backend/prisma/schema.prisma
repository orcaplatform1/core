}

// ORCA ACS'nin kripto ICT/SMC kural motorunun BIREBIR ayni calisan, tek farki
// kirilim onaylandiktan sonra order flow (agresif alim baskisi) teyidi de
// arayan test varyanti - hangisi daha iyi performans gosterirse o kalir
// (kullanici istegi 2026-08-23: iki strateji paralel/es zamanli test edilsin,
// Money Maker'a (gercek Binance emirleri) KESINLIKLE baglanmaz, sadece
// TrackedSignal/ScanResult uzerinden win-rate karsilastirmasi icin var).
// Tek satirlik "singleton" tablo, AutoTradeConfig ile ayni desen.
model ScannerConfig {
  id                   String   @id @default(cuid())
  orderFlowTestEnabled Boolean  @default(true)
  // "Yeni sinyal bulundu" bildirimleri (ORCA ACS + Test Flow, ikisi ayni
  // runScheduledDayTradeScan yolundan gectigi icin tek anahtar yeter) -
  // kullanici istegi 2026-08-23: Money Maker'a adapte olurken bir sure bu
  // bildirimleri kapatip paneli manuel kontrol edecek. Taramanin KENDISINI
  // durdurmaz, sadece admin bildirimini keser. Forex bildirimleri BUNA
  // baglanmiyor - kullanici sadece kripto/ORCA ACS+Test Flow icin istedi.
  cryptoSignalNotificationsEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model TrackedSignal {
