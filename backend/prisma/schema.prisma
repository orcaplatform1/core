generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String?            @unique
  phone             String?            @unique
  password          String?
  fullName          String
  username          String?            @unique
  avatarUrl         String?
  dateOfBirth       DateTime?
  education         EducationLevel?
  gender            Gender?
  occupation        OccupationType?
  role              Role               @default(GUEST)
  toolsSubscription SubscriptionStatus @default(NONE)

  googleId        String? @unique
  appleId         String? @unique
  profileComplete Boolean @default(true)

  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?
  phoneVerified            Boolean   @default(false)
  phoneVerificationCode    String?
  phoneVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  refreshTokenHash         String?

  dailyGoalLessons  Int @default(1)
  weeklyGoalLessons Int @default(5)
  streakGoalDays    Int @default(30)

  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  lastLoginAt      DateTime?

  sessionId   String?
  bannedUntil DateTime?
  banCount    Int       @default(0)

  promoCode         String?           @unique
  mentorCredits     Int               @default(0)
  referredByStaffId String?
  financialProfile  FinancialProfile?

  // Ilk 500 program satin alan ogrenciye ilk odeme onaylandiginda bir kereligine
  // set edilir (bkz. payments.service.ts approve()) - sonradan program sayisi
  // artsa da geri alinmaz. Ekstra bir yetki/rol vermez, sadece rozet + topluluk
  // gonderilerinde "Kurucu Uye" etiketi icin kullanilir.
  isFoundingMember Boolean @default(false)

  referredByUserId      String?
  referredBy            User?   @relation("StudentReferral", fields: [referredByUserId], references: [id])
  referrals             User[]  @relation("StudentReferral")
  referralCreditsEarned Int     @default(0)
  periodPoints          Int     @default(0)
  totalPoints           Int     @default(0)

  payments                Payment[]              @relation("PaymentBuyer")
  referredPayments        Payment[]              @relation("PaymentReferrer")
  studentReferredPayments Payment[]              @relation("PaymentStudentReferrer")
  sponsorships            Sponsorship[]          @relation("SponsorshipSubmitter")
  quizAttempts            QuizAttempt[]
  progress                Progress[]
  certificates            Certificate[]
  invoices                Invoice[]
  subscriptions           Subscription[]
  enrollments             Enrollment[]
  loginLogs               LoginLog[]
  backtestTrades          BacktestTrade[]
  notifications           Notification[]
  statsSnapshots          StatsSnapshot[]
  userBadges              UserBadge[]
  commissionsEarned       Commission[]
  conversation            Conversation?
  simulationAccount       SimulationAccount?
  simulationDnaReports    SimulationDnaReport[]
  comments                Comment[]
  commentReactions        CommentReaction[]
  blocksMade              Block[]                @relation("Blocker")
  blocksReceived          Block[]                @relation("Blocked")
  dmSent                  DmMessage[]            @relation("DmSent")
  dmReceived              DmMessage[]            @relation("DmReceived")
  dmReports               DmMessageReport[]
  commentReports          CommentReport[]
  suspensionsReceived     UserSuspension[]       @relation("SuspendedUser")
  suspensionsIssued       UserSuspension[]       @relation("SuspensionIssuer")
  supportTickets          SupportTicket[]
  supportMessagesSent     SupportTicketMessage[]
  lessonNotes             LessonNote[]
  lessonTaskProgress      LessonTaskProgress[]
  communityPosts          CommunityPost[]
  postLikes               PostLike[]
  postComments            PostComment[]
  postReports             PostReport[]
  successStory            SuccessStory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

enum DmMessageStatus {
  SENT
  BLOCKED_PROFANITY
  BLOCKED_RATE_LIMIT
  BLOCKED_USER_BLOCKED
  BLOCKED_SUSPENDED
}

model DmMessage {
  id            String            @id @default(cuid())
  senderId      String
  sender        User              @relation("DmSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId   String
  recipient     User              @relation("DmReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  content       String
  status        DmMessageStatus   @default(SENT)
  blockedReason String?
  readAt        DateTime?
  editedAt      DateTime?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime          @default(now())
  edits         DmMessageEdit[]
  reports       DmMessageReport[]

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([createdAt])
}

model DmMessageEdit {
  id              String    @id @default(cuid())
  messageId       String
  message         DmMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  previousContent String
  editedAt        DateTime  @default(now())
}

model DmMessageReport {
  id         String    @id @default(cuid())
  messageId  String
  message    DmMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime  @default(now())
}

model CommentReport {
  id         String   @id @default(cuid())
  commentId  String
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now())
}

enum SuspensionType {
  COMMENT
  DM
}

// Yorum veya mesajlasma ozelligini gecici olarak kisitlayan yaptirim kaydi. Suren
// gecince otomatik olarak biter (expiresAt kontrolu ile, ayrica bir "aktif" flag
// tutulmuyor) - gecmis kayitlar panelde ceza gecmisi olarak kalmaya devam eder.
model UserSuspension {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation("SuspendedUser", fields: [userId], references: [id], onDelete: Cascade)
  type       SuspensionType
  reason     String?
  issuedById String
  issuedBy   User           @relation("SuspensionIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime       @default(now())

  @@index([userId, type])
}

model SupportTicket {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  SupportTicketCategory
  status    SupportTicketStatus    @default(OPEN)
  messages  SupportTicketMessage[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  closedAt  DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model Lead {
  id               String           @id @default(cuid())
  phone            String           @unique
  financialProfile FinancialProfile
  answers          Json?
  staffPromoCode   String?
  convertedUserId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Commission {
  id        String   @id @default(cuid())
  staffId   String
  staff     User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  paymentId String
  amount    Float
  rate      Float
  createdAt DateTime @default(now())
}

model Program {
  id            String        @id @default(cuid())
  title         String
  slug          String?       @unique
  description   String?
  coverImageUrl String?
  level         ProgramLevel?
  durationHours Int?
  order         Int           @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  modules Module[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id          String  @id @default(cuid())
  title       String
  description String?
  order       Int     @default(1)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  description String?
  order       Int     @default(1)

  videoUrl        String?
  pdfUrl          String?
  durationSeconds Int?

  resources LessonResource[]
  quizzes   Quiz[]
  comments  Comment[]
  notes     LessonNote[]
  task      LessonTask?
  moduleId  String
  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  LIKE
  DISLIKE
}

model Comment {
  id        String            @id @default(cuid())
  lessonId  String
  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  content   String
  status    CommentStatus     @default(APPROVED)
  editedAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  reactions CommentReaction[]
  reports   CommentReport[]
  edits     CommentEdit[]

  @@index([lessonId, status])
  @@index([parentId])
}

model CommentEdit {
  id              String   @id @default(cuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  previousContent String
  editedAt        DateTime @default(now())
}

model CommentReaction {
  id        String       @id @default(cuid())
  commentId String
  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([commentId, userId])
}

model LessonResource {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name     String
  url      String

  createdAt DateTime @default(now())
}

// Ogrencinin bir derse ozel kisisel notu - kullanici basina ders basina tek not (upsert).
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

// SUPER_ADMIN tarafindan derse eklenen uygulama gorevi ("Aktif Gorev" karti).
// Quiz'den ayri - ders tamamlanmasini ETKILEMEZ, sadece bilgilendirme/takip amaclidir.
model LessonTask {
  id          String   @id @default(cuid())
  lessonId    String   @unique
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  description String
  targetCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress LessonTaskProgress[]
}

model LessonTaskProgress {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String
  task           LessonTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedCount Int        @default(0)
  completed      Boolean    @default(false)
  updatedAt      DateTime   @updatedAt

  @@unique([userId, taskId])
}

model Quiz {
  id          String     @id @default(cuid())
  title       String
  description String?
  questions   Question[]

  timeLimitMinutes Int @default(20)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id          String   @id @default(cuid())
  title       String
  description String?
  explanation String?
  answers     Answer[]

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Answer {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizAttempt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId String

  lessonId  String
  moduleId  String
  programId String

  totalQuestions Int @default(0)
  correctAnswers Int @default(0)
  wrongAnswers   Int @default(0)
  percentage     Int @default(0)
  score          Int @default(0)

  passed  Boolean    @default(false)
  grade   QuizGrade?
  expired Boolean    @default(false)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([quizId])
}

model QuizAnswer {
  id String @id @default(cuid())

  quizAttemptId String

  questionId String

  selectedAnswerId String

  isCorrect Boolean

  timeSpent Int @default(0)

  answeredAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quizAttemptId, questionId])
}

model Progress {
  id String @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String?
  moduleId  String?
  lessonId  String?
  quizId    String?

  completed      Boolean @default(false)
  progress       Int     @default(0)
  watchedSeconds Int     @default(0)

  lastAccessAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, lessonId])
}

model Certificate {
  id          String   @id @default(cuid())
  number      Int      @unique @default(autoincrement())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  programId   String?
  code        String   @unique
  studentName String?
  issuedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SuccessStoryStatus {
  PENDING
  APPROVED
  REJECTED
}

model SuccessStory {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  content String

  status          SuccessStoryStatus @default(PENDING)
  rejectionReason String?
  moderatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId])
}

model Payment {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation("PaymentBuyer", fields: [userId], references: [id], onDelete: Restrict)
  amount     Float
  currency   String
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  receiptUrl String?
  approvedAt DateTime?

  cryptoProvider    CryptoProvider?
  purpose           PaymentPurpose  @default(PROGRAM)
  creditAmount      Int?
  promoCodeUsed     String?
  discountApplied   Float?
  referredByStaffId String?
  referredByStaff   User?           @relation("PaymentReferrer", fields: [referredByStaffId], references: [id])
  referralType      ReferralType?
  referredByUserId  String?
  referredByUser    User?           @relation("PaymentStudentReferrer", fields: [referredByUserId], references: [id])
  invoice           Invoice?

  cryptoAsset        CryptoAsset?
  cryptoAmountLocked Float?
  cryptoRateTRY      Float?
  cryptoRateLockedAt DateTime?

  sponsorship Sponsorship?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model WeeklyChallengeCompletion {
  id         String   @id @default(cuid())
  userId     String
  weekStart  DateTime
  rewardedAt DateTime @default(now())

  @@unique([userId, weekStart])
}

model MentorSuggestion {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

model PlatformSettings {
  id                     String   @id @default("singleton")
  programPriceTRY        Float    @default(4500)
  // Sponsor (ICO/Airdrop reklam) fiyat kademeleri, USD - odeme aninda gunun
  // USDT/TRY kuruyla TRY'ye cevrilir (bkz. PaymentsService.create SPONSORSHIP dali).
  sponsorshipPrice7dUSD  Float    @default(150)
  sponsorshipPrice15dUSD Float    @default(250)
  sponsorshipPrice30dUSD Float    @default(400)
  updatedAt              DateTime @updatedAt
}

enum CryptoAsset {
  BTC
  ETH
  BNB
  USDT
}

model Invoice {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement())
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount    Float
  currency  String
  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  programs  Program[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Badge {
  id            String           @id @default(cuid())
  name          String           @unique
  description   String
  iconUrl       String?
  triggerType   BadgeTriggerType @default(CUSTOM)
  requiredCount Int              @default(1)
  users         UserBadge[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  lessonId       String?
  imageUrl       String?
  createdAt      DateTime     @default(now())
}

model SimulationAccount {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float            @default(10000)
  trades    SimulatedTrade[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SimulatedTrade {
  id         String            @id @default(cuid())
  accountId  String
  account    SimulationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol     String
  direction  TradeDirection
  quantity   Float
  leverage   Int               @default(1)
  entryPrice Float
  exitPrice  Float?
  pnl        Float?
  status     TradeStatus       @default(OPEN)
  createdAt  DateTime          @default(now())
  closedAt   DateTime?
}

model SimulationDnaReport {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradesAnalyzedCount Int
  pending             Boolean  @default(true)
  riskProfile         String?
  psychologyLabel     String?
  strengths           Json?
  weaknesses          Json?
  developmentPlan     String?
  createdAt           DateTime @default(now())

  @@index([userId])
}

model HistoricalCandle {
  id        String    @id @default(cuid())
  symbol    String
  assetType AssetType @default(CRYPTO)
  timeframe String    @default("1d")
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
}

model BacktestTrade {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  direction  TradeDirection
  quantity   Float
  entryPrice Float
  entryDate  DateTime
  exitPrice  Float?
  exitDate   DateTime?
  pnl        Float?
  status     TradeStatus    @default(OPEN)
  createdAt  DateTime       @default(now())
}

model LoginLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  loggedInAt DateTime @default(now())

  @@index([userId])
}

model LiveLesson {
  id              String   @id @default(cuid())
  title           String
  scheduledAt     DateTime
  durationMinutes Int
  discordLink     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  link        String?
  read        Boolean                @default(false)
  createdAt   DateTime               @default(now())
  broadcastId String?
  broadcast   AnnouncementBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([broadcastId])
}

// Admin panelden gönderilen bir duyuru, alıcı sayısı kadar Notification satırına
// "fan-out" olur (bkz. ManageService.broadcastAnnouncement); bu model o gönderimin
// tekil kaydı — admin panelde "bugüne kadar gönderilen duyurular" listesini ve
// admin sildiğinde ilişkili tüm Notification'ların da silinmesini (cascade) sağlar.
model AnnouncementBroadcast {
  id            String         @id @default(cuid())
  title         String
  message       String
  target        String
  link          String?
  createdByName String?
  createdAt     DateTime       @default(now())
  notifications Notification[]
}

model StatsSnapshot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart    DateTime
  overallScore Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, weekStart])
}

model ScanResult {
  id           String    @id @default(cuid())
  results      Json
  style        String    @default("SWING")
  market       AssetType @default(CRYPTO)
  strategyName String    @default("SUPPLY_DEMAND_ZONE")
