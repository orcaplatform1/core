  // otomatik doldurulur - null ise akiste gorunur, doluysa moderasyon
  // kuyruguna dusmus ve herkesten gizlenmis demektir.
  hiddenAt DateTime?

  // "Haftanin Setup'i" - admin manage/community'den elle sec/kaldir (otomatik
  // rotasyon yok). Ayni anda en fazla bir post true olabilir, yeni biri
  // secildiginde oncekinin pin'i community.service.ts icinde transaction ile
  // otomatik kaldirilir.
  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    PostLike[]
  comments PostComment[]
  reports  PostReport[]

  @@index([symbol])
  @@index([createdAt])
  @@index([isPinned])
  @@index([hiddenAt])
}

model PostLike {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime      @default(now())

  @@index([postId])
}

model PostReport {
  id         String           @id @default(cuid())
  postId     String
  post       CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     PostReportStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  @@unique([postId, reporterId])
}

// ---------- Airdrop Center (CoinMarketCap/Galxe/Layer3/DappRadar) ----------
enum AirdropStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum AirdropDifficulty {
  EASY
  MEDIUM
  HARD
}

model Airdrop {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  projectName       String
  blockchain        String
  category          String
  logo              String?
  banner            String?
  description       String?           @db.Text
  website           String?
  twitter           String?
  discord           String?
  telegram          String?
  documentation     String?
  status            AirdropStatus     @default(UPCOMING)
  rewardType        String
  estimatedReward   String?
  estimatedValueUSD Float?
  difficulty        AirdropDifficulty @default(MEDIUM)
  completionTime    String?
  requiresKYC       Boolean           @default(false)
  requiresWallet    Boolean           @default(false)
  requiresDiscord   Boolean           @default(false)
  requiresTwitter   Boolean           @default(false)
  requiresTelegram  Boolean           @default(false)
  startDate         DateTime?
  endDate           DateTime?
  snapshotDate      DateTime?
  claimDate         DateTime?
  aiScore           Int               @default(50)
  riskScore         Int               @default(50)
  featured          Boolean           @default(false)
  // #Ads etiketi: true ise listelerde tarih/eklenme sirasindan bagimsiz
  // olarak en usttte gosterilir (birden fazla reklamli kayit varsa aralarinda
  // en son eklenen ustte). adExpiresAt gecince (bkz. servisteki cron) isAd
  // otomatik false'a doner, kayit normal siraya geri doner - SILINMEZ.
  isAd              Boolean           @default(false)
  adExpiresAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([blockchain])
  @@index([category])
  @@index([difficulty])
  @@index([featured])
  @@index([isAd])
}

// ---------- Sponsor (ucretli ICO/Airdrop reklam) basvurulari ----------

enum SponsorshipType {
  ICO
  AIRDROP
}

// AWAITING_PAYMENT: form dolduruldu, odeme henuz tamamlanmadi.
// PENDING_REVIEW: kripto odemesi onaylandi (webhook), admin incelemesi bekliyor.
// APPROVED: admin onayladi - formData'dan gercek IcoProject/Airdrop kaydi
// otomatik olusturuldu (isAd=true, adExpiresAt=durationDays), tum kullanicilara
// bildirim gitti. REJECTED: admin reddetti (odeme iade sureci platform disinda).
enum SponsorshipStatus {
  AWAITING_PAYMENT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Sponsorship {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation("SponsorshipSubmitter", fields: [userId], references: [id], onDelete: Restrict)
  type   SponsorshipType
  status SponsorshipStatus @default(AWAITING_PAYMENT)

  durationDays Int
  priceUsd     Float

  contactName     String
  contactEmail    String
  contactTelegram String?

  // CreateIcoProjectDto veya CreateAirdropDto ile ayni sekilde (isAd/adExpiresAt
  // haric) - onay aninda SponsorshipsService bunu ilgili servise iletir.
  formData Json

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdIcoId     String?
  createdAirdropId String?

  rejectionReason String?
  reviewedAt      DateTime?
  reviewedByName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

// ---------- Ziyaretci Deneme Suresi (Araclar + Topluluk, giris yapmamis kullanicilar) ----------
// cookieId, httpOnly + uzun omurlu (1 yil) bir cerezde tasinan rastgele bir
// kimlik - ilk erisimde olusturulur, expiresAt (firstAccessAt + 2dk) gecince
// bu kayit kalici olarak "suresi doldu" sayilir, SILINMEZ (ayni cerezle bir
// daha deneme hakki verilmez). Kullanici cerezleri temizlerse yeni bir
// cookieId ile yeni bir kayit olusur - cerez-bazli takibin dogasinda olan,
// kacinilmaz bir sinir (bkz. VisitorTrialService).
model AnonymousVisitor {
  id            String   @id @default(cuid())
  cookieId      String   @unique
  firstAccessAt DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}
